# Copy to firmware/.env (git-ignored) and fill in.
# Used by the firmware build (cmake/ota_secrets.cmake) and tools/ota.mjs.
# No quotes. Everything after "=" is the value (spaces at the ends are trimmed).

# 2.4 GHz Wi-Fi only (the Pico has no 5 GHz). WPA2.
WIFI_SSID=MyHomeWifi
WIFI_PASSWORD=change-me

# Shared secret for OTA uploads. 1..47 characters. Make up a long random one.
OTA_TOKEN=change-me-to-something-random

# Optional: where tools/ota.mjs finds the car (default lego-car.local).
# OTA_HOST=192.168.1.50
